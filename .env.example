# Para carregar variáveis de ambiente, configure-as no Windows, Docker ou servidor.
# Opcional: 1 cria pedidos e clientes de exemplo no primeiro início.
DEMO_SEED=1
# Em HTTPS de produção, configure COOKIE_SECURE=1.
COOKIE_SECURE=1
# Diretório persistente para o banco e fotos (opcional):
# ESQUADRA_DATA_DIR=/caminho/persistente/esquadra
