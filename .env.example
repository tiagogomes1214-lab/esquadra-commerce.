# Exemplo somente. NAO envie valores reais de acesso para o GitHub.
# Para criar automaticamente o primeiro administrador em hospedagem publica,
# defina ambos no painel da Discloud, na area de variaveis de ambiente:
ESQUADRA_ADMIN_USERNAME=admin_da_loja
ESQUADRA_ADMIN_PASSWORD=substituir_por_senha_forte_16_caracteres_ou_mais

# Configuradas automaticamente por discloud_start.py:
# ESQUADRA_PUBLIC_DEPLOYMENT=1
# COOKIE_SECURE=1
# DEMO_SEED=0

# Opcional: local persistente de dados, se houver armazenamento persistente na hospedagem:
# ESQUADRA_DATA_DIR=/caminho/persistente/esquadra
